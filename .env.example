# ContextOS Server Configuration
CONTEXTOS_HOST=127.0.0.1
CONTEXTOS_PORT=8000

# On-Device Small Language Model (SLM) Settings
# Connects to local Ollama runtime (http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended default for Intel 13th Gen / 16GB RAM:
# Options: qwen2.5:1.5b | qwen2.5:0.5b | qwen2.5:3b | phi3:mini | llama3.2:1b
SLM_MODEL_NAME=qwen2.5:1.5b

# Privacy & Security Settings
CONTEXT_TRACKING_ENABLED=true
LOCAL_ONLY_INFERENCE=true
RETENTION_DAYS=7

